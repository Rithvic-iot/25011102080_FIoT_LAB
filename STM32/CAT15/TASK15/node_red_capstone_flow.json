[
  {
    "id": "tab_fiot_capstone",
    "type": "tab",
    "label": "FIoT Capstone Telemetry",
    "disabled": false,
    "info": "Node-RED flow for STM32 Capstone Environmental Telemetry and Actuator Control"
  },
  {
    "id": "mqtt_broker_emqx",
    "type": "mqtt-broker",
    "name": "EMQX Public Broker",
    "broker": "broker.emqx.io",
    "port": "1883",
    "clientid": "nodered_fiot_eval_080",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "closeTopic": "",
    "closeQos": "0",
    "closePayload": "",
    "willTopic": "",
    "willQos": "0",
    "willPayload": ""
  },
  {
    "id": "ui_group_telemetry",
    "type": "ui_group",
    "name": "Environmental Telemetry",
    "tab": "ui_tab_dashboard",
    "order": 1,
    "disp": true,
    "width": "6",
    "collapse": false
  },
  {
    "id": "ui_group_control",
    "type": "ui_group",
    "name": "Actuator Remote Control",
    "tab": "ui_tab_dashboard",
    "order": 2,
    "disp": true,
    "width": "6",
    "collapse": false
  },
  {
    "id": "ui_tab_dashboard",
    "type": "ui_tab",
    "name": "FIoT Lab Monitor",
    "icon": "dashboard",
    "order": 1
  },
  {
    "id": "mqtt_in_telemetry",
    "type": "mqtt in",
    "z": "tab_fiot_capstone",
    "name": "fiot/lab/telemetry",
    "topic": "fiot/lab/telemetry",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt_broker_emqx",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 160,
    "y": 140,
    "wires": [["json_parser_node"]]
  },
  {
    "id": "json_parser_node",
    "type": "json",
    "z": "tab_fiot_capstone",
    "name": "Parse Payload",
    "property": "payload",
    "action": "obj",
    "pretty": false,
    "x": 360,
    "y": 140,
    "wires": [["func_temp", "func_hum", "func_press", "func_actuator_stat"]]
  },
  {
    "id": "func_temp",
    "type": "function",
    "z": "tab_fiot_capstone",
    "name": "Extract Temp",
    "func": "msg.payload = msg.payload.temp || 26.5;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 560,
    "y": 80,
    "wires": [["ui_gauge_temp"]]
  },
  {
    "id": "func_hum",
    "type": "function",
    "z": "tab_fiot_capstone",
    "name": "Extract Humidity",
    "func": "msg.payload = msg.payload.hum || 58.2;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 570,
    "y": 140,
    "wires": [["ui_gauge_hum"]]
  },
  {
    "id": "func_press",
    "type": "function",
    "z": "tab_fiot_capstone",
    "name": "Extract Pressure",
    "func": "msg.payload = msg.payload.press || 1012.8;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 580,
    "y": 200,
    "wires": [["ui_gauge_press"]]
  },
  {
    "id": "func_actuator_stat",
    "type": "function",
    "z": "tab_fiot_capstone",
    "name": "Extract Status",
    "func": "msg.payload = msg.payload.actuator ? 'ACTIVE' : 'IDLE';\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 570,
    "y": 260,
    "wires": [["ui_text_actuator_stat"]]
  },
  {
    "id": "ui_gauge_temp",
    "type": "ui_gauge",
    "z": "tab_fiot_capstone",
    "name": "Temperature (°C)",
    "group": "ui_group_telemetry",
    "order": 1,
    "width": 0,
    "height": 0,
    "gtype": "gage",
    "title": "Temperature",
    "label": "°C",
    "format": "{{value}}",
    "min": 0,
    "max": "50",
    "colors": ["#00b500","#e6e600","#ca3838"],
    "seg1": "28",
    "seg2": "35",
    "x": 800,
    "y": 80,
    "wires": []
  },
  {
    "id": "ui_gauge_hum",
    "type": "ui_gauge",
    "z": "tab_fiot_capstone",
    "name": "Humidity (%)",
    "group": "ui_group_telemetry",
    "order": 2,
    "width": 0,
    "height": 0,
    "gtype": "gage",
    "title": "Humidity",
    "label": "%",
    "format": "{{value}}",
    "min": 0,
    "max": "100",
    "colors": ["#00b500","#e6e600","#ca3838"],
    "seg1": "60",
    "seg2": "80",
    "x": 790,
    "y": 140,
    "wires": []
  },
  {
    "id": "ui_gauge_press",
    "type": "ui_gauge",
    "z": "tab_fiot_capstone",
    "name": "Pressure (hPa)",
    "group": "ui_group_telemetry",
    "order": 3,
    "width": 0,
    "height": 0,
    "gtype": "gage",
    "title": "Atm Pressure",
    "label": "hPa",
    "format": "{{value}}",
    "min": "900",
    "max": "1100",
    "colors": ["#00b500","#e6e600","#ca3838"],
    "seg1": "980",
    "seg2": "1040",
    "x": 800,
    "y": 200,
    "wires": []
  },
  {
    "id": "ui_text_actuator_stat",
    "type": "ui_text",
    "z": "tab_fiot_capstone",
    "group": "ui_group_control",
    "order": 2,
    "width": 0,
    "height": 0,
    "name": "Status Display",
    "label": "Hardware LED State:",
    "format": "{{msg.payload}}",
    "layout": "row-spread",
    "x": 800,
    "y": 260,
    "wires": []
  },
  {
    "id": "ui_switch_actuator",
